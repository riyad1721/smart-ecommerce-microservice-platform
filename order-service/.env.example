APP_NAME=order-service
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg2://auth_user:auth_pass@127.0.0.1:5433/auth_db

JWT_SECRET_KEY=my-secret-key
JWT_ALGORITHM=HS256

PRODUCT_SERVICE_BASE_URL=http://127.0.0.1:8001

RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/
RABBITMQ_EXCHANGE=ecommerce.events
ORDER_CREATED_ROUTING_KEY=order.created
PAYMENT_COMPLETED_ROUTING_KEY=payment.completed
PAYMENT_FAILED_ROUTING_KEY=payment.failed

ENABLE_RABBITMQ_CONSUMER=true
